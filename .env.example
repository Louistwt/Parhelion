# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
# Optional: fal ADMIN key, needed for balance / billing-events (parhelion cost sync, dashboard balance)
FAL_ADMIN_KEY=

# Budget guard (USD)
# A full clip run (12 shots) costs ~$2.50, so allow ~$10 per run
PARHELION_MAX_SPEND_PER_RUN=10
PARHELION_MONTHLY_BUDGET=50
# Display currency for reports: USD or HKD (converted with rate in config/pipeline.yaml)
PARHELION_CURRENCY=USD

# --- Optional / future stages (not used in storyboard scope) ---
GEMINI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
