{
  "name": "parhelion",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run parhelion ui --no-browser --reload",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "typecheck": "npm --workspace web run typecheck",
    "start": "npm run build && uv run parhelion ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.9.3"
  }
}
